{
  "name": "vela",
  "version": "0.1.0",
  "private": true,
  "description": "A privacy-focused desktop web browser.",
  "type": "module",
  "main": "out/main/index.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "prebuild": "node scripts/fetch-filters.mjs --if-missing",
    "filters:update": "node scripts/fetch-filters.mjs"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-store": "^11.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
